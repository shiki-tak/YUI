# Ollama：通常の推論
YUI_OLLAMA_HOST=http://localhost:11434
# 設計書の初期候補は qwen3:8b。未取得なら `ollama pull qwen3:8b`、
# 手元の別モデルを使う場合はここを書き換える（例：gemma4）。
YUI_OLLAMA_MODEL=qwen3:8b
YUI_OLLAMA_TEMPERATURE=0.8
YUI_OLLAMA_NUM_CTX=8192
YUI_LLM_TIMEOUT_SECONDS=120

# DB
YUI_DATABASE_URL=sqlite+aiosqlite:///./data/yui.db

# 記憶検索
YUI_MEMORY_RETRIEVAL_LIMIT=8
YUI_RECENT_MESSAGE_LIMIT=12

# CORS（Vite 開発サーバー）
YUI_CORS_ORIGINS=http://localhost:5173
