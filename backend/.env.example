# VOICEVOX Engine：音声合成
YUI_VOICEVOX_HOST=http://localhost:50021
# 59 = 猫使ビィ／おちつき。他の話者は /speakers で確認できるが、
# 話者ごとに利用規約とクレジット表記の条件が違う。
YUI_VOICEVOX_SPEAKER=59
YUI_VOICEVOX_TIMEOUT_SECONDS=30
# 音声を公開する場に出すクレジット。話者を変えるときは一緒に直す。
YUI_VOICEVOX_CREDIT=VOICEVOX:猫使ビィ
# エンジンが無い環境では false にする。
YUI_SPEECH_ENABLED=true

# DB
YUI_DATABASE_URL=sqlite+aiosqlite:///./data/yui.db

# CORS（Vite 開発サーバー）
YUI_CORS_ORIGINS=http://localhost:5173
