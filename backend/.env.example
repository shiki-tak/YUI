# Ollama：通常の推論
YUI_OLLAMA_HOST=http://localhost:11434
# 未取得なら `ollama pull qwen3.5:9b`。
YUI_OLLAMA_MODEL=qwen3.5:9b
YUI_OLLAMA_TEMPERATURE=0.8
YUI_OLLAMA_NUM_CTX=8192
# 思考出力。会話では切る（記憶を使う正確さは変わらず、応答が約60倍速い）。
# 空にするとモデルの既定に任せる。
YUI_OLLAMA_THINK=false
YUI_LLM_TIMEOUT_SECONDS=120

# VOICEVOX Engine：音声合成
YUI_VOICEVOX_HOST=http://localhost:50021
# 59 = 猫使ビィ／おちつき。他の話者は /speakers で確認できるが、
# 話者ごとに利用規約とクレジット表記の条件が違う。
YUI_VOICEVOX_SPEAKER=59
YUI_VOICEVOX_TIMEOUT_SECONDS=30
# 音声を公開する場に出すクレジット。話者を変えるときは一緒に直す。
YUI_VOICEVOX_CREDIT=VOICEVOX:猫使ビィ
# エンジンが無い環境では false にする。会話は続けられる。
YUI_SPEECH_ENABLED=true

# 固定人格：personas/<版>.toml を読む。版を増やして比較する（フェーズ3の3A）。
# 会話ごとに切り替えるときは POST /api/chat の persona_version で指定する。
YUI_PERSONA_VERSION=2026-09-07.1
YUI_PERSONA_DIR=personas

# DB
YUI_DATABASE_URL=sqlite+aiosqlite:///./data/yui.db

# 記憶検索
YUI_MEMORY_RETRIEVAL_LIMIT=8
YUI_RECENT_MESSAGE_LIMIT=12

# CORS（Vite 開発サーバー）
YUI_CORS_ORIGINS=http://localhost:5173
