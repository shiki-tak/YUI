%% images/architecture.png の元データ。**コンポーネント図**である。
%% 実際に動く部品・配置境界・技術名を示す。
%% docs/design/ai_vtuber_architecture.md 第3節の図は責任分担の抽象図で、別物。
%% 粒度が違うので、どちらかに合わせて潰さない。
%% ---
%% 注記の無い部品は実装済み（v0.1〜v0.2）。
%% (v0.5) などの版注記は未実装で、その版で作るもの。
%% 「既定で無効」は実装済みだが、設定で既定オフのもの。
%% 破線は未実装の追加能力・任意の接続先・並行トラック（設計書 第7節）。
%% 評価器（app/evaluation）はこの図に含めない。通常の経路とは別に起動する
%% 開発用のコマンドで、会話進行を直接呼ぶ。
%% ---
%% 図が崩れるので次に注意する:
%%   - 空行だけの %% を置かない（パースエラーになる）
%%   - subgraph 内の direction は外部エッジがあると無視される
%%   - 連結していないノードを並べると縦に伸びる。必ずエッジで繋ぐ
%% 更新するには次を実行する:
%%   npx -y @mermaid-js/mermaid-cli -i docs/design/architecture.mmd \
%%       -o images/architecture.png -b white -s 3
flowchart TB
    ME["開発者：文字入力"]

    subgraph BROWSER["ブラウザ：React・TypeScript"]
        UI["操作画面：会話・記憶・状態の確認"]
        AVATAR["アバター・字幕・音声再生"]
    end

    YTIN["YouTube：視聴者コメント<br/>（並行トラック）"]
    WHISPER["whisper.cpp：音声入力<br/>（並行トラック）"]

    subgraph BACKEND["Pythonバックエンド：FastAPI（単一プロセス）"]
        API["FastAPI：HTTP<br/>/chat・/speech・/delivery・/end"]
        INPUT["入力受付・会話ロック<br/>会話ごとに直列化（発話キューは並行トラック）"]
        AGENT["キャラクター中核：自作Python<br/>固定人格・記憶検索・関心・関係性"]
        GOAL["目標：採用・発火判定・完了<br/>発火はコードで決める (v0.5)"]
        CONV["会話状態（規則）：未回答の質問<br/>延期・終了・提示済み"]
        INTERP["解釈（LLM）：現在の用件・訂正の受け入れ<br/>食い違い（既定で無効）"]
        REFLECT["振り返り：会話後に<br/>記憶・可変状態の候補を作る"]
        LLMMOD["LLM接続モジュール"]
        CHECK["出力検査：終了・延期・食い違い<br/>終了時は1回だけ再生成"]
        DB[("SQLite：SQLAlchemy・Alembic<br/>会話・記憶・可変状態・会話状態<br/>実行記録・音声記録")]
    end

    subgraph LOCALAI["ローカルAIサービス"]
        OLLAMA["Ollama：通常の推論"]
        MLX["MLX-LM：将来の推論候補"]
        VISION["視覚モデル：画像理解（並行トラック）"]
        VOICEVOX["VOICEVOX Engine：音声合成"]
    end

    subgraph EXTERNAL["外部サービス"]
        SEARCH["検索API：出典・取得日時つき（並行トラック）"]
        CLAUDE["Claude API：分析・追加判定<br/>（未実装）"]
    end

    OBS["OBS Studio<br/>（並行トラック）"]
    YTLIVE["YouTube Live<br/>（並行トラック）"]

    ME --> UI
    UI -- "HTTP" --> API
    API -- "文字入力" --> INPUT
    YTIN -. "YouTube API" .-> INPUT
    WHISPER -. "文字起こし" .-> API
    INPUT --> AGENT
    AGENT -. "発火判定・切り出す目標" .-> GOAL
    AGENT <-- "更新と参照" --> CONV
    CONV -. "既定では呼ばない" .-> INTERP
    INTERP -. "解決・取消・作成" .-> CONV
    AGENT --> LLMMOD
    AGENT -- "参照した記憶・人格版・公開範囲で絞る" --> DB
    API -- "会話の終了後 /end" --> REFLECT
    REFLECT -- "候補の抽出" --> LLMMOD
    REFLECT -- "採用待ちの候補" --> DB
    LLMMOD --> OLLAMA
    LLMMOD -. "将来の切り替え先" .-> MLX
    LLMMOD -. "画像入力時（並行トラック）" .-> VISION
    AGENT -. "明示的な依頼のみ（並行トラック）" .-> SEARCH
    SEARCH -. "出典・日時つきの情報" .-> AGENT
    LLMMOD -. "難しい分析（未実装）" .-> CLAUDE
    CLAUDE -. "分析結果" .-> LLMMOD
    LLMMOD --> CHECK
    CHECK -- "確定した返答・会話状態・実行記録" --> DB
    API -- "GET /speech：返答の本文" --> VOICEVOX
    VOICEVOX -- "生成音声・合成時間" --> API
    API -- "字幕・音声" --> AVATAR
    AVATAR -- "POST /delivery：開始・完了・中断" --> API
    AVATAR -. "画面・音声" .-> OBS
    OBS -. "配信" .-> YTLIVE
